@echo off
REM ============================================================
REM  客户工作台启动脚本（本地，仅监听 127.0.0.1）
REM
REM  用法：把本脚本放在「工作目录」下（与 tools/ 同级），双击即可。
REM  自动定位脚本所在目录，不依赖任何硬编码路径。
REM ============================================================
setlocal
cd /d "%~dp0"

echo 正在启动本地客户工作台 ...
echo 浏览器将自动打开 http://127.0.0.1:8610
echo 按 Ctrl+C 或关闭本窗口即停止服务。

start "" http://127.0.0.1:8610
python tools\workbench.py

pause
endlocal
